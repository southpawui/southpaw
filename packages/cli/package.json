{
  "name": "southpawui",
  "version": "0.0.0",
  "private": true,
  "description": "Install Southpaw UI components into your React project.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "southpawui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "pnpm build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cac": "^7.1.1",
    "get-tsconfig": "^4.14.3",
    "package-manager-detector": "^1.9.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
