{
  "name": "@southpawui/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm registry && next dev --port 3001",
    "build": "pnpm registry && next build",
    "start": "next start --port 3001",
    "registry": "node ../../packages/registry/build.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm registry && next typegen && tsc --noEmit",
    "verify": "node --experimental-strip-types --no-warnings scripts/verify-docs.ts"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@phosphor-icons/react": "^2.1.10",
    "@southpawui/registry": "workspace:*",
    "@southpawui/tokens": "workspace:*",
    "@southpawui/ui": "workspace:*",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.19.5",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-typescript": "^5.6.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.5",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "20.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
